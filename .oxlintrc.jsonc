{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "import",
    "jsdoc",
    "node",
    "promise",
    "oxc",
    "typescript",
    "unicorn",
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off",
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/__snapshots__/**",
  ],
  "rules": {
    "unicorn/filename-case": ["warn", { "case": "camelCase" }],
    "curly": ["warn", "all"],
    "func-style": ["warn", "declaration", { "allowArrowFunctions": true }],
    "no-duplicate-imports": [
      "warn",
      { "includeExports": false, "allowSeparateTypeImports": true },
    ],
    "one-var": ["error", "never"],
  },
  "overrides": [
    {
      "files": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"],
      "jsPlugins": [
        {
          "name": "ntnyq",
          "specifier": "eslint-plugin-ntnyq",
        },
      ],
      "rules": {
        "ntnyq/padding-line-between-statements": [
          "error",
          // The last matching entry wins, so exceptions follow their general rules.
          {
            "blankLine": "always",
            "prev": "*",
            "next": [
              "if",
              "for",
              "while",
              "do",
              "switch",
              "try",
              "return",
              "throw",
            ],
          },
          {
            "blankLine": "always",
            "prev": ["if", "for", "while", "do", "switch", "try"],
            "next": "*",
          },
          {
            "blankLine": "always",
            "prev": ["const", "let", "var"],
            "next": "*",
          },
          {
            "blankLine": "any",
            "prev": ["const", "let", "var"],
            "next": ["const", "let", "var"],
          },
          {
            "blankLine": "always",
            "prev": "*",
            "next": ["function", "class"],
          },
          {
            "blankLine": "always",
            "prev": ["function", "class"],
            "next": "*",
          },
          {
            "blankLine": "always",
            "prev": "import",
            "next": "*",
          },
          {
            "blankLine": "never",
            "prev": "import",
            "next": "import",
          },
        ],
      },
    },
    {
      "files": ["*.config.{ts,mjs}"],
      "rules": {
        "sort-keys": "warn",
      },
    },
    {
      "files": ["*.{spec,test}.{js,ts,tsx}", "*.{spec,test}-d.{ts,tsx}"],
      "plugins": ["vitest"],
    },
  ],
}
