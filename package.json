{
  "name": "eslint-plugin-webmcp",
  "version": "0.0.0",
  "description": "Conservative ESLint rules for versioned browser WebMCP APIs",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "model-context",
    "typescript",
    "webmcp"
  ],
  "homepage": "https://github.com/ntnyq/eslint-plugin-webmcp#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/eslint-plugin-webmcp/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/eslint-plugin-webmcp.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck test build smoke",
    "release:version": "bumpp",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.69.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@ntnyq/tsconfig": "^3.1.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/rule-tester": "^8.69.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
